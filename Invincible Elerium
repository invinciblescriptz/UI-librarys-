local function Connect(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(Connections, conn)
    return conn
end

local function DisconnectAll()
    for _, conn in ipairs(Connections) do
        if conn.Connected then
            conn:Disconnect()
        end
    end
    Connections = {}
end

Connect(UserInputService.InputBegan, function(input, gameProcessed)
    if input.KeyCode == (typeof(Library.toggle_key) == "EnumItem" and Library.toggle_key or Enum.KeyCode.RightShift) then
        if ScreenGui and not Binding then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end
end)

local function Tween(obj, props, time)
    time = time or 0.12
    if time <= 0 then
        for k, v in pairs(props) do
            obj[k] = v
        end
        return
    end
    local info = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

local function ApplyGradient(obj, colors, rotation)
    local existing = obj:FindFirstChildOfClass("UIGradient")
    if existing then
        existing:Destroy()
    end

    if typeof(colors) == "Color3" then
        colors = {colors}
    end
    if not colors or #colors == 0 then
        return
    end

    if #colors == 1 then
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            obj.ImageColor3 = colors[1]
        else
            obj.BackgroundColor3 = colors[1]
        end
        return
    end

    local gradient = Instance.new("UIGradient")
    gradient.Parent = obj
    gradient.Rotation = rotation or 0

    local keypoints = {}
    for i, color in ipairs(colors) do
        local t = (i - 1) / (#colors - 1)
        table.insert(keypoints, ColorSequenceKeypoint.new(t, color))
    end
    gradient.Color = ColorSequence.new(keypoints)

    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        obj.ImageColor3 = Color3.new(1, 1, 1)
    else
        obj.BackgroundColor3 = Color3.new(1, 1, 1)
    end
end

local function RGBToHSV(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local max, min = math.max(r, g, b), math.min(r, g, b)
    local h, s, v = 0, 0, max
    local d = max - min
    s = max == 0 and 0 or d / max
    if max == min then
        h = 0
    else
        if max == r then
            h = (g - b) / d + (g < b and 6 or 0)
        elseif max == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end
    return h, s, v
end

