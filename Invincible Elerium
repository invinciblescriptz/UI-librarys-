local LibraryAPI = {}

function LibraryAPI:FormatWindows()
    local layout = Prefabs:FindFirstChild("UIListLayout")
    if not layout then
        layout = Instance.new("UIListLayout")
    end
    layout.Parent = Windows
    local positions = {}
    for _, child in ipairs(Windows:GetChildren()) do
        if not child:IsA("UIListLayout") then
            positions[child] = child.AbsolutePosition
        end
    end
    layout:Destroy()
    for obj, pos in pairs(positions) do
        obj.Position = UDim2.new(0, pos.X, 0, pos.Y)
    end
end

function LibraryAPI:AddWindow(title, options)
    WindowCount = WindowCount + 1
    local draggingBlocked = false

    title = tostring(title or "New Window")
    options = typeof(options) == "table" and options or {}

    options.tween_time = options.tween_time or 0.15
    options.title_bar = options.title_bar or {Color3.fromRGB(0, 0, 0)}
    if typeof(options.title_bar) == "Color3" then
        options.title_bar = {options.title_bar}
    end
    options.title_bar_transparency = options.title_bar_transparency or 0
    options.background = options.background or {Color3.fromRGB(21, 22, 23)}
    if typeof(options.background) == "Color3" then
        options.background = {options.background}
    end
    options.background_transparency = options.background_transparency or 0.05
    options.main_color = options.main_color or options.title_bar[1]
    options.min_size = options.min_size or Library.min_size
    options.can_resize = options.can_resize ~= false

    local window = Prefabs.Window:Clone()
    window.Parent = Windows
    window.Title.Text = title
    window.Size = UDim2.new(0, options.min_size.X, 0, options.min_size.Y)
    window.ZIndex = window.ZIndex + WindowCount * 10

    local bar = window.Bar
    local toggleBtn = bar.Toggle
    local tabSelection = window.TabSelection
    local tabsFrame = window.Tabs

    bar.Size = UDim2.new(1, 0, 0, 24)
    bar.Position = UDim2.new(0, 0, 0, 0)
    bar.Active = true

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = bar

    toggleBtn.Position = UDim2.new(0, 5, 0, 2)
    window.Title.Position = UDim2.new(0, 28, 0, 2)
    window.Title.Size = UDim2.new(1, -40, 0, 20)
    window.Title.TextXAlignment = Enum.TextXAlignment.Center
    window.Title.Active = false

    bar.BackgroundTransparency = options.title_bar_transparency
    ApplyGradient(bar, options.title_bar, 0)

    if tabSelection then
        tabSelection.Size = UDim2.new(1, -30, 0, 22)
        tabSelection.Position = UDim2.new(0, 15, 0, 28)
        local tsCorner = Instance.new("UICorner")
        tsCorner.CornerRadius = UDim.new(0, 6)
        tsCorner.Parent = tabSelection
        tabSelection.ImageTransparency = options.title_bar_transparency or 0
        ApplyGradient(tabSelection, options.title_bar, 0)
    end

    window.ImageTransparency = options.background_transparency
    ApplyGradient(window, options.background, 45)

    local collapsed = false
    local animating = false
    local savedHeight = options.min_size.Y
    local resizer = window.Resizer

    -- ========== INVISIBLE DRAG ZONE (this is what actually makes it work) ==========
    local DragZone = Instance.new("TextButton")
    DragZone.Name = "DragZone"
    DragZone.Parent = window
    DragZone.BackgroundTransparency = 1
    DragZone.Text = ""
    DragZone.Size = UDim2.new(1, -30, 0, 24) -- leaves space for the toggle button
    DragZone.Position = UDim2.new(0, 30, 0, 0)
    DragZone.ZIndex = 50
    DragZone.AutoButtonColor = false
    -- ==============================================================================

    toggleBtn.MouseButton1Click:Connect(function()
        if animating then return end
        animating = true

        local absPos = window.AbsolutePosition
        local absSize = window.AbsoluteSize
        local parentAbsPos = window.Parent.AbsolutePosition
        local relX = absPos.X - parentAbsPos.X
        local relY = absPos.Y - parentAbsPos.Y
        local width = absSize.X

        if not collapsed then
            savedHeight = absSize.Y
            resizer.Active = false
            tabSelection.Visible = false
            tabsFrame.Visible = false

            local newH = 24
            local newCenterX = relX + width / 2
            local newCenterY = relY + newH / 2

            Tween(window, {
                Size = UDim2.new(0, width, 0, newH),
                Position = UDim2.new(0, newCenterX, 0, newCenterY)
            }, options.tween_time)

            task.delay(options.tween_time + 0.02, function()
                collapsed = true
                animating = false
            end)
        else
            tabsFrame.Visible = true
            if #tabSelection.TabScrolling.TabButtons:GetChildren() > 1 then
                tabSelection.Visible = true
            end
            resizer.Active = options.can_resize

            local newH = savedHeight
            local newCenterX = relX + width / 2
            local newCenterY = relY + newH / 2

            Tween(window, {
                Size = UDim2.new(0, width, 0, newH),
                Position = UDim2.new(0, newCenterX, 0, newCenterY)
            }, options.tween_time)

            task.delay(options.tween_time + 0.02, function()
                collapsed = false
                animating = false
            end)
        end
    end)

    local windowAPI = {}

    -- ========== ROCK SOLID DRAGGING ==========
    do
        local dragging = false
        local dragStart = nil
        local startPos = nil

        DragZone.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if draggingBlocked or animating then return end
                dragging = true
                dragStart = input.Position
                startPos = window.Position
            end
        end)

        Connect(UserInputService.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                window.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)

        Connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end
    -- ========================================

    do
        local oldIcon = Mouse.Icon
        local hovering = false
        local resizing = false
        local resizeConn

        resizer.MouseEnter:Connect(function()
            if options.can_resize then
                oldIcon = Mouse.Icon
            end
            hovering = true
        end)

        resizer.MouseLeave:Connect(function()
            hovering = false
            if options.can_resize then
                Mouse.Icon = oldIcon
            end
        end)

        Connect(UserInputService.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                if hovering and resizer.Active and options.can_resize and not collapsed then
                    resizing = true
                    resizeConn = RunService.Heartbeat:Connect(function()
                        if not resizing or not resizer.Active then
                            if resizeConn then
                                resizeConn:Disconnect()
                                resizeConn = nil
                            end
                            return
                        end
                        local pos = GetMousePos()
                        local w = math.max(options.min_size.X, pos.X - window.AbsolutePosition.X)
                        local h = math.max(options.min_size.Y, pos.Y - window.AbsolutePosition.Y)
                        window.Size = UDim2.new(0, w, 0, h)
                        savedHeight = h
                    end)
                end
            end
        end)

        Connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = false
                if resizeConn then
                    resizeConn:Disconnect()
                    resizeConn = nil
                end
            end
        end)
    end

    do
        local tabsContainer = window.Tabs
        local tabSel = window.TabSelection
        local tabScroll = tabSel.TabScrolling
        local tabButtonsFrame = tabScroll.TabButtons
        local currentTabBtn = nil

        local function UpdateTabButtonsSize()
            local total = 0
            local padding = tabButtonsFrame:FindFirstChildOfClass("UIListLayout").Padding.Offset or 0
            for _, btn in ipairs(tabButtonsFrame:GetChildren()) do
                if btn:IsA("TextButton") then
                    total = total + btn.AbsoluteSize.X + padding
                end
            end
            tabButtonsFrame.Size = UDim2.new(0, total, 1, 0)
            if tabScroll then
                tabScroll.CanvasSize = UDim2.new(0, total, 0, 0)
            end
        end

        function windowAPI:AddTab(name)
            local tabAPI = {}
            name = tostring(name or "New Tab")
            tabSel.Visible = true

            local tabBtn = Prefabs.TabButton:Clone()
            tabBtn.Parent = tabButtonsFrame
            tabBtn.Text = name
            tabBtn.Size = UDim2.new(0, GetTextWidth(tabBtn) + 16, 0, 18)
            tabBtn.ZIndex = tabBtn.ZIndex + WindowCount * 10
            tabBtn.BackgroundTransparency = 1

            local btnRound = tabBtn:FindFirstChild("Round")
            if btnRound then
                btnRound.ZIndex = tabBtn.ZIndex + WindowCount * 10
                btnRound.ImageTransparency = options.title_bar_transparency or 0
                ApplyGradient(btnRound, options.title_bar, 0)
            end

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = tabBtn

            tabBtn.TextColor3 = Color3.fromRGB(190, 190, 190)
            tabBtn.TextSize = 13
            tabBtn.Font = Enum.Font.Fondamento

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.new(0, 0, 0)
            stroke.Thickness = 1.1
            stroke.Transparency = 0.65
            stroke.Parent = tabBtn

            local outline = Instance.new("Frame")
            outline.Name = "TabOutline"
            outline.Size = UDim2.new(1, 0, 1, 0)
            outline.BackgroundTransparency = 1
            outline.BorderSizePixel = 2
            outline.BorderColor3 = options.main_color
            outline.ZIndex = tabBtn.ZIndex + 10
            outline.Visible = false
            local outlineCorner = Instance.new("UICorner")
            outlineCorner.CornerRadius = UDim.new(0, 4)
            outlineCorner.Parent = outline
            outline.Parent = tabBtn

            local tabFrame = Prefabs.Tab:Clone()
            tabFrame.Parent = tabsContainer
            tabFrame.ZIndex = tabFrame.ZIndex + WindowCount * 10
            tabFrame.Visible = false
            tabFrame.ClipsDescendants = false
            tabFrame.Size = UDim2.new(1, 0, 1, 0)
            tabFrame.BackgroundTransparency = 1

            local scroller = Instance.new("ScrollingFrame")
            scroller.Name = "TabScroller"
            scroller.Parent = tabFrame
            scroller.Size = UDim2.new(1, 0, 1, 0)
            scroller.BackgroundTransparency = 1
            scroller.BorderSizePixel = 0
            scroller.ScrollBarThickness = 4
            scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
            scroller.ZIndex = tabFrame.ZIndex
            scroller.ScrollBarImageColor3 = Color3.fromRGB(255, 80, 80)
            scroller.ScrollBarImageTransparency = 0.35

            local layout = tabFrame:FindFirstChildOfClass("UIListLayout")
            if layout then
                layout.Parent = scroller
            end

            local function UpdateCanvas()
                local contentY = layout.AbsoluteContentSize.Y
                scroller.CanvasSize = UDim2.new(0, 0, 0, contentY + 12)
            end
            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
            UpdateCanvas()
            task.defer(UpdateTabButtonsSize)

            local function SelectTab()
                if draggingBlocked then return end
                if currentTabBtn and currentTabBtn ~= tabBtn then
                    local oldOutline = currentTabBtn:FindFirstChild("TabOutline")
                    if oldOutline then
                        oldOutline.Visible = false
                    end
                    currentTabBtn.TextColor3 = Color3.fromRGB(190, 190, 190)
                end
                for _, child in ipairs(tabsContainer:GetChildren()) do
                    if child:IsA("Frame") then
                        child.Visible = false
                    end
                end
                currentTabBtn = tabBtn
                local ol = tabBtn:FindFirstChild("TabOutline")
                if ol then
                    ol.Visible = true
                    ol.BorderColor3 = options.main_color
                end
                tabBtn.TextColor3 = Color3.new(1, 1, 1)
                tabFrame.Visible = true
            end

            tabBtn.MouseButton1Click:Connect(SelectTab)
            tabBtn.MouseEnter:Connect(function()
                if tabBtn ~= currentTabBtn then
                    tabBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
                end
            end)
            tabBtn.MouseLeave:Connect(function()
                if tabBtn ~= currentTabBtn then
                    tabBtn.TextColor3 = Color3.fromRGB(190, 190, 190)
                end
            end)

            function tabAPI:Show()
                SelectTab()
            end

            tabBtn.AncestryChanged:Connect(function()
                if not tabBtn.Parent then
                    if currentTabBtn == tabBtn then
                        currentTabBtn = nil
                    end
                end
            end)

            if #tabButtonsFrame:GetChildren() == 2 then
                SelectTab()
            end

            function tabAPI:AddLabel(text)
                text = tostring(text or "Label")
                local lbl = Prefabs.Label:Clone()
                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                lbl.Parent = parent
                lbl.Text = text
                lbl.Size = UDim2.new(0, GetTextWidth(lbl), 0, 20)
                lbl.ZIndex = lbl.ZIndex + WindowCount * 10
                return lbl
            end

            function tabAPI:AddButton(text, callback)
                text = tostring(text or "Button")
                callback = typeof(callback) == "function" and callback or function() end
                local btn = Prefabs.Button:Clone()
                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                btn.Parent = parent
                btn.Text = text
                btn.Size = UDim2.new(0, GetTextWidth(btn), 0, 22)
                btn.ZIndex = btn.ZIndex + WindowCount * 10
                local round = btn:FindFirstChild("Round")
                if round then
                    round.ZIndex = round.ZIndex + WindowCount * 10
                    round.ImageTransparency = options.title_bar_transparency or 0
                    ApplyGradient(round, options.title_bar, 0)
                end
                btn.TextColor3 = Color3.new(1, 1, 1)
                btn.MouseButton1Click:Connect(function()
                    Ripple(btn, Mouse.X, Mouse.Y)
                    pcall(callback)
                end)
                return btn
            end

            function tabAPI:AddSwitch(text, callback)
                local api = {}
                text = tostring(text or "Switch")
                callback = typeof(callback) == "function" and callback or function() end
                local sw = Prefabs.Switch:Clone()
                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                sw.Parent = parent
                sw.Title.Text = text
                sw.Title.ZIndex = sw.Title.ZIndex + WindowCount * 10
                sw.ZIndex = sw.ZIndex + WindowCount * 10
                local round = sw:FindFirstChild("Round")
                if round then
                    round.ZIndex = round.ZIndex + WindowCount * 10
                    round.ImageTransparency = options.title_bar_transparency or 0
                    ApplyGradient(round, options.title_bar, 0)
                end
                local state = false
                sw.MouseButton1Click:Connect(function()
                    state = not state
                    sw.Text = state and utf8.char(10003) or ""
                    pcall(callback, state)
                end)
                function api:Set(value)
                    state = typeof(value) == "boolean" and value or false
                    sw.Text = state and utf8.char(10003) or ""
                    pcall(callback, state)
                end
                return api, sw
            end

            function tabAPI:AddTextBox(placeholder, callback, flags)
                placeholder = tostring(placeholder or "TextBox")
                callback = typeof(callback) == "function" and callback or function() end
                flags = typeof(flags) == "table" and flags or {clear = false}
                flags.clear = flags.clear == true
                local box = Prefabs.TextBox:Clone()
                box.Size = UDim2.new(0.5, -5, 0, 22)
                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                box.Parent = parent
                box.PlaceholderText = placeholder
                box.ZIndex = box.ZIndex + WindowCount * 10
                local round = box:FindFirstChild("Round")
                if round then
                    round.ZIndex = round.ZIndex + WindowCount * 10
                    round.ImageTransparency = options.title_bar_transparency or 0
                    ApplyGradient(round, options.title_bar, 0)
                end
                box.TextColor3 = Color3.new(1, 1, 1)
                box.PlaceholderColor3 = Color3.fromRGB(180, 180, 180)
                box.FocusLost:Connect(function(enter)
                    if enter and #box.Text > 0 then
                        pcall(callback, box.Text)
                        if flags.clear then
                            box.Text = ""
                        end
                    end
                end)
                return box
            end

            function tabAPI:AddSlider(text, callback, flags)
                local api = {}
                text = tostring(text or "Slider")
                callback = typeof(callback) == "function" and callback or function() end
                flags = typeof(flags) == "table" and flags or {}
                flags.min = flags.min or 0
                flags.max = flags.max or 100
                flags.readonly = flags.readonly or false

                local slider = Prefabs.Slider:Clone()
                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                slider.Parent = parent
                slider.ZIndex = slider.ZIndex + WindowCount * 10

                local titleLbl = slider.Title
                local indicator = slider.Indicator
                local valueLbl = slider.Value
                titleLbl.ZIndex = titleLbl.ZIndex + WindowCount * 10
                indicator.ZIndex = indicator.ZIndex + WindowCount * 10
                valueLbl.ZIndex = valueLbl.ZIndex + WindowCount * 10
                titleLbl.Text = text

                local hovering = false
                local dragging = false
                local dragConn

                slider.MouseEnter:Connect(function()
                    hovering = true
                end)
                slider.MouseLeave:Connect(function()
                    hovering = false
                end)

                Connect(UserInputService.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        if hovering and not flags.readonly then
                            dragging = true
                            dragConn = RunService.Heartbeat:Connect(function()
                                if not dragging or draggingBlocked then
                                    if dragConn then
                                        dragConn:Disconnect()
                                        dragConn = nil
                                    end
                                    return
                                end
                                local pos = GetMousePos()
                                local pct = math.clamp((pos.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
                                indicator.Size = UDim2.new(pct, 0, 1, 0)
                                local range = flags.max - flags.min
                                local val = math.floor(range * pct + flags.min)
                                valueLbl.Text = tostring(val)
                                pcall(callback, val)
                            end)
                        end
                    end
                end)

                Connect(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                        if dragConn then
                            dragConn:Disconnect()
                            dragConn = nil
                        end
                    end
                end)

                function api:Set(value)
                    value = tonumber(value) or 0
                    value = math.clamp(value, flags.min, flags.max)
                    local pct = (value - flags.min) / (flags.max - flags.min)
                    indicator.Size = UDim2.new(pct, 0, 1, 0)
                    valueLbl.Text = tostring(math.floor(value))
                    pcall(callback, math.floor(value))
                end

                api:Set(flags.min)
                return api, slider
            end

            function tabAPI:AddKeybind(text, callback, flags)
                local api = {}
                text = tostring(text or "Keybind")
                callback = typeof(callback) == "function" and callback or function() end
                flags = typeof(flags) == "table" and flags or {}
                flags.standard = flags.standard or Enum.KeyCode.RightShift

                local kb = Prefabs.Keybind:Clone()
                local inputBtn = kb.Input
                local titleLbl = kb.Title
                kb.ZIndex = kb.ZIndex + WindowCount * 10
                inputBtn.ZIndex = inputBtn.ZIndex + WindowCount * 10
                if inputBtn:FindFirstChild("Round") then
                    inputBtn.Round.ZIndex = inputBtn.Round.ZIndex + WindowCount * 10
                end
                titleLbl.ZIndex = titleLbl.ZIndex + WindowCount * 10

                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                kb.Parent = parent
                titleLbl.Text = "  " .. text
                kb.Size = UDim2.new(0, GetTextWidth(titleLbl) + 90, 0, 22)

                local keyNames = {
                    RightControl = "RightCtrl",
                    LeftControl = "LeftCtrl",
                    LeftShift = "LShift",
                    RightShift = "RShift",
                    MouseButton1 = "Mouse1",
                    MouseButton2 = "Mouse2"
                }

                local currentKey = flags.standard

                function api:SetKeybind(key)
                    local name = keyNames[key.Name] or key.Name
                    inputBtn.Text = name
                    currentKey = key
                end

                Connect(UserInputService.InputBegan, function(input, gp)
                    if Binding then
                        task.defer(function()
                            Binding = false
                        end)
                        return
                    end
                    if input.KeyCode == currentKey and not gp then
                        pcall(callback, currentKey)
                    end
                end)

                api:SetKeybind(flags.standard)

                inputBtn.MouseButton1Click:Connect(function()
                    if Binding then return end
                    inputBtn.Text = "..."
                    Binding = true
                    local input = UserInputService.InputBegan:Wait()
                    api:SetKeybind(input.KeyCode)
                end)

                return api, kb
            end

            function tabAPI:AddDropdown(text, callback)
                local api = {}
                text = tostring(text or "Dropdown")
                callback = typeof(callback) == "function" and callback or function() end

                local dd = Prefabs.Dropdown:Clone()
                local box = dd.Box
                local objects = box.Objects
                local indicator = dd.Indicator
                dd.ZIndex = dd.ZIndex + WindowCount * 10
                box.ZIndex = box.ZIndex + WindowCount * 10
                objects.ZIndex = objects.ZIndex + WindowCount * 10
                indicator.ZIndex = indicator.ZIndex + WindowCount * 10
                dd.Size = UDim2.new(0.5, -5, 0, 22)

                local round = dd:FindFirstChild("Round")
                if round then
                    round.ZIndex = round.ZIndex + WindowCount * 10
                    round.ImageTransparency = options.title_bar_transparency or 0
                    ApplyGradient(round, options.title_bar, 0)
                end
                box.ImageTransparency = options.background_transparency or 0.05
                ApplyGradient(box, options.background, 0)

                local boxCorner = Instance.new("UICorner")
                boxCorner.CornerRadius = UDim.new(0, 6)
                boxCorner.Parent = box

                objects.BackgroundTransparency = 1
                objects.Position = UDim2.new(0, 0, 0, 0)
                objects.Size = UDim2.new(1, 0, 1, 0)

                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                dd.Parent = parent
                dd.Text = "      " .. text
                box.Size = UDim2.new(1, 0, 0, 0)
                box.Position = UDim2.new(0, 0, 0, 26)
                dd.TextColor3 = Color3.new(1, 1, 1)

                local open = false
                local openUp = false

                dd.MouseButton1Click:Connect(function()
                    open = not open
                    local height = math.min((#objects:GetChildren() - 1) * 20, 200)
                    if #objects:GetChildren() - 1 >= 10 then
                        objects.CanvasSize = UDim2.new(0, 0, (#objects:GetChildren() - 1) * 0.1, 0)
                    end

                    if open then
                        if draggingBlocked then return end
                        draggingBlocked = true
                        local btnY = dd.AbsolutePosition.Y
                        local btnH = dd.AbsoluteSize.Y
                        local winBottom = window.AbsolutePosition.Y + window.AbsoluteSize.Y
                        local spaceBelow = winBottom - (btnY + btnH)

                        if spaceBelow < height then
                            openUp = true
                            box.Position = UDim2.new(0, 0, 0, -height - 5)
                            box.Size = UDim2.new(1, 0, 0, 0)
                            local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            TweenService:Create(box, info, {
                                Size = UDim2.new(1, 0, 0, height),
                                Position = UDim2.new(0, 0, 0, -height - 5)
                            }):Play()
                            Tween(indicator, {Rotation = -90}, options.tween_time)
                        else
                            openUp = false
                            box.Position = UDim2.new(0, 0, 0, 26)
                            box.Size = UDim2.new(1, 0, 0, 0)
                            Tween(box, {Size = UDim2.new(1, 0, 0, height)}, options.tween_time)
                            Tween(indicator, {Rotation = 90}, options.tween_time)
                        end
                    else
                        draggingBlocked = false
                        if openUp then
                            local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            local tw = TweenService:Create(box, info, {
                                Size = UDim2.new(1, 0, 0, 0),
                                Position = UDim2.new(0, 0, 0, -5)
                            })
                            tw:Play()
                            tw.Completed:Connect(function()
                                box.Position = UDim2.new(0, 0, 0, 26)
                            end)
                        else
                            Tween(box, {Size = UDim2.new(1, 0, 0, 0)}, options.tween_time)
                        end
                        Tween(indicator, {Rotation = -90}, options.tween_time)
                    end
                end)

                function api:Add(option)
                    local optAPI = {}
                    option = tostring(option or "Option")
                    local optBtn = Prefabs.DropdownButton:Clone()
                    optBtn.Parent = objects
                    optBtn.Text = "      " .. option
                    optBtn.ZIndex = optBtn.ZIndex + WindowCount * 10 + 5
                    optBtn.BackgroundTransparency = 1
                    optBtn.TextColor3 = Color3.new(1, 1, 1)
                    optBtn.BorderSizePixel = 0
                    optBtn.TextXAlignment = Enum.TextXAlignment.Left

                    local stroke = Instance.new("UIStroke")
                    stroke.Color = Color3.new(0, 0, 0)
                    stroke.Thickness = 1
                    stroke.Transparency = 0.3
                    stroke.Parent = optBtn

                    optBtn.MouseEnter:Connect(function()
                        optBtn.BackgroundTransparency = 0.75
                        optBtn.BackgroundColor3 = options.main_color
                    end)
                    optBtn.MouseLeave:Connect(function()
                        optBtn.BackgroundTransparency = 1
                    end)

                    if open then
                        local height = math.min((#objects:GetChildren() - 1) * 20, 200)
                        if #objects:GetChildren() - 1 >= 10 then
                            objects.CanvasSize = UDim2.new(0, 0, (#objects:GetChildren() - 1) * 0.1, 0)
                        end
                        if openUp then
                            local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            TweenService:Create(box, info, {
                                Size = UDim2.new(1, 0, 0, height),
                                Position = UDim2.new(0, 0, 0, -height - 5)
                            }):Play()
                        else
                            Tween(box, {Size = UDim2.new(1, 0, 0, height)}, options.tween_time)
                        end
                    end

                    optBtn.MouseButton1Click:Connect(function()
                        if draggingBlocked then
                            dd.Text = "      [ " .. option .. " ]"
                            draggingBlocked = false
                            open = false
                            if openUp then
                                local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                                local tw = TweenService:Create(box, info, {
                                    Size = UDim2.new(1, 0, 0, 0),
                                    Position = UDim2.new(0, 0, 0, -5)
                                })
                                tw:Play()
                                tw.Completed:Connect(function()
                                    box.Position = UDim2.new(0, 0, 0, 26)
                                end)
                            else
                                Tween(box, {Size = UDim2.new(1, 0, 0, 0)}, options.tween_time)
                            end
                            Tween(indicator, {Rotation = -90}, options.tween_time)
                            pcall(callback, option)
                        end
                    end)

                    function optAPI:Remove()
                        optBtn:Destroy()
                    end

                    return optBtn, optAPI
                end

                function api:Remove(name)
                    local child = objects:FindFirstChild(name)
                    if child then
                        child:Destroy()
                    end
                end

                return api, dd
            end

            function tabAPI:AddHorizontalAlignment()
                local api = {}
                local frame = Prefabs.HorizontalAlignment:Clone()
                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                frame.Parent = parent

                function api:AddButton(...)
                    local results = {tabAPI:AddButton(...)}
                    local btn = results[#results]
                    btn.Parent = frame
                    return table.unpack(results)
                end

                return api, frame
            end

            function tabAPI:AddFolder(name)
                local folderAPI = {}
                name = tostring(name or "Folder")

                local folder = Prefabs.Folder:Clone()
                local btn = folder.Button
                local objects = folder.Objects
                local toggleIcon = btn.Toggle
                folder.ZIndex = folder.ZIndex + WindowCount * 10
                btn.ZIndex = btn.ZIndex + WindowCount * 10
                objects.ZIndex = objects.ZIndex + WindowCount * 10
                toggleIcon.ZIndex = toggleIcon.ZIndex + WindowCount * 10
                if btn:FindFirstChild("Round") then
                    btn.Round.ZIndex = btn.Round.ZIndex + WindowCount * 10
                end

                local parent = tabFrame:FindFirstChild("TabScroller") or tabFrame
                folder.Parent = parent
                btn.Text = "      " .. name
                local round = btn:FindFirstChild("Round")
                if round then
                    round.ImageColor3 = options.main_color
                end

                local open = false

                btn.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        Tween(toggleIcon, {Rotation = 90}, options.tween_time)
                        objects.Visible = true
                        local h = 26
                        for _, child in ipairs(objects:GetChildren()) do
                            if not child:IsA("UIListLayout") then
                                h = h + child.AbsoluteSize.Y + 5
                            end
                        end
                        Tween(folder, {Size = UDim2.new(1, 0, 0, h)}, options.tween_time)
                    else
                        Tween(toggleIcon, {Rotation = 0}, options.tween_time)
                        objects.Visible = false
                        Tween(folder, {Size = UDim2.new(1, 0, 0, 22)}, options.tween_time)
                    end
                end)

                for k, v in pairs(tabAPI) do
                    folderAPI[k] = function(...)
                        local results = {v(...)}
                        local last = results[#results]
                        if last and typeof(last) == "Instance" then
                            last.Parent = objects
                        end
                        return table.unpack(results)
                    end
                end

                return folderAPI, folder
            end

            return tabAPI, tabFrame
        end
    end

    for _, desc in ipairs(window:GetDescendants()) do
        if pcall(function() return desc.ZIndex end) then
            desc.ZIndex = desc.ZIndex + WindowCount * 10
        end
    end

    return windowAPI, window
end

ScreenGui.AncestryChanged:Connect(function()
    if not ScreenGui.Parent then
        DisconnectAll()
    end
end)

return LibraryAPI
