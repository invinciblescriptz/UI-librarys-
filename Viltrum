	for _, conn in ipairs(connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	connections = {}
end

add_connection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == ((typeof(ui_options.toggle_key) == "EnumItem") and ui_options.toggle_key or Enum.KeyCode.RightShift) then
		if script.Parent and not library_state.binding then
			script.Parent.Enabled = not script.Parent.Enabled
		end
	end
end))

local function tween(obj, props, time)
	time = time or 0.1
	if time == 0 then
		for prop, value in pairs(props) do
			obj[prop] = value
		end
		return
	end
	local info = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tweenObj = TweenService:Create(obj, info, props)
	tweenObj:Play()
	return tweenObj
end

local function apply_gradient(obj, colors, rotation)
	local existing = obj:FindFirstChild("UIGradient")
	if existing then
		existing:Destroy()
	end
	if typeof(colors) == "Color3" then
		colors = { colors }
	end
	if not colors or #colors == 0 then
		return
	end
	if #colors == 1 then
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.ImageColor3 = colors[1]
		else
			obj.BackgroundColor3 = colors[1]
		end
		return
	end
	local gradient = Instance.new("UIGradient")
	gradient.Parent = obj
	gradient.Rotation = rotation or 0
	local keypoints
	if #colors == 2 then
		keypoints = {
			ColorSequenceKeypoint.new(0, colors[1]),
			ColorSequenceKeypoint.new(1, colors[2]),
		}
	elseif #colors >= 3 then
		keypoints = {
			ColorSequenceKeypoint.new(0, colors[1]),
			ColorSequenceKeypoint.new(0.5, colors[2]),
			ColorSequenceKeypoint.new(1, colors[3]),
		}
	end
	gradient.Color = ColorSequence.new(keypoints)
	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		obj.ImageColor3 = Color3.new(1, 1, 1)
	else
		obj.BackgroundColor3 = Color3.new(1, 1, 1)
	end
end

local function rgb_to_hsv(r, g, b)
	r, g, b = r / 255, g / 255, b / 255
	local max, min = math.max(r, g, b), math.min(r, g, b)
	local h, s, v = 0, 0, max
	local d = max - min
	s = (max == 0) and 0 or (d / max)
	if max == min then
		h = 0
	else
		if max == r then
			h = ((g - b) / d) + ((g < b) and 6 or 0)
		elseif max == g then
			h = ((b - r) / d) + 2
		elseif max == b then
			h = ((r - g) / d) + 4
		end
		h = h / 6
	end
	return h, s, v
end

local function has_property(obj, prop)
	local success, result = pcall(function()
		return obj[tostring(prop)]
	end)
	return success and result
end

local function get_text_size(textLabel)
	return textLabel.TextBounds.X + 15
end

local function get_mouse_pos()
	return Vector2.new(UserInputService:GetMouseLocation().X + 1, UserInputService:GetMouseLocation().Y - 35)
end

local function create_ripple(parent, x, y)
	task.spawn(function()
		parent.ClipsDescendants = true
		local ripple = Prefabs:FindFirstChild("Circle"):Clone()
		ripple.Parent = parent
		ripple.ZIndex = 1000
		local offsetX = x - ripple.AbsolutePosition.X
		local offsetY = y - ripple.AbsolutePosition.Y
		ripple.Position = UDim2.new(0, offsetX, 0, offsetY)
		local size = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 1.5
		ripple:TweenSizeAndPosition(
			UDim2.new(0, size, 0, size),
			UDim2.new(0.5, -size / 2, 0.5, -size / 2),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			0.5,
			false
		)
		tween(ripple, { ImageTransparency = 1 }, 0.5)
		task.wait(0.5)
		ripple:Destroy()
	end)
end

