					local mouseDown = false
					local dragConn
					UserInputService.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							mouseDown = true
							dragConn = RunService.Heartbeat:Connect(function()
								if not mouseDown or dropdown_open then
									if dragConn then
										dragConn:Disconnect()
										dragConn = nil
									end
									return
								end
								if overPalette then
									local pos = get_mouse_pos()
									local px = math.clamp((pos.X - pal.AbsolutePosition.X) / pal.AbsoluteSize.X, 0, 1)
									local py = math.clamp((pos.Y - pal.AbsolutePosition.Y) / pal.AbsoluteSize.Y, 0, 1)
									h = px
									s = 1 - py
									palInd.Position = UDim2.new(px, -palInd.AbsoluteSize.X / 2, py, -palInd.AbsoluteSize.Y / 2)
									update()
								elseif overSat then
									local pos = get_mouse_pos()
									local py = math.clamp((pos.Y - sat.AbsolutePosition.Y) / sat.AbsoluteSize.Y, 0, 1)
									v = 1 - py
									satInd.Position = UDim2.new(0, 0, py, 0)
									update()
								end
							end)
						end
					end)
					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							mouseDown = false
							if dragConn then
								dragConn:Disconnect()
								dragConn = nil
							end
						end
					end)

					cp_data.Set = function(self, color)
						color = (typeof(color) == "Color3") and color or Color3.new(1, 1, 1)
						local rh, rs, rv = rgb_to_hsv(color.r * 255, color.g * 255, color.b * 255)
						samp.ImageColor3 = color
						sat.ImageColor3 = Color3.fromHSV(rh, 1, 1)
						pcall(callback, color)
					end
					return cp_data, cp
				end

				tab_data.AddHorizontalAlignment = function(self)
					local ha_data = {}
					local ha = Prefabs:FindFirstChild("HorizontalAlignment"):Clone()
					local parent = TabFrame:FindFirstChild("TabScroller") or TabFrame
					ha.Parent = parent
					ha_data.AddButton = function(self, ...)
						local results = { tab_data:AddButton(...) }
						local btn = results[#results]
						btn.Parent = ha
						return table.unpack(results)
					end
					return ha_data, ha
				end

				tab_data.AddFolder = function(self, name)
					local folder_data = {}
					name = tostring(name or "New Folder")
					local fld = Prefabs:FindFirstChild("Folder"):Clone()
					local btn = fld:FindFirstChild("Button")
					local objs = fld:FindFirstChild("Objects")
					local tog = btn:FindFirstChild("Toggle")
					fld.ZIndex = fld.ZIndex + (window_count * 10)
					btn.ZIndex = btn.ZIndex + (window_count * 10)
					objs.ZIndex = objs.ZIndex + (window_count * 10)
					tog.ZIndex = tog.ZIndex + (window_count * 10)
					btn:GetChildren()[1].ZIndex = btn:GetChildren()[1].ZIndex + (window_count * 10)

					local parent = TabFrame:FindFirstChild("TabScroller") or TabFrame
					fld.Parent = parent
					btn.Text = "      " .. name
					local round = btn:GetChildren()[1]
					round.ImageColor3 = options.main_color

					local function calc_height()
						local h = 25
						for _, child in ipairs(objs:GetChildren()) do
							if not child:IsA("UIListLayout") then
								h = h + child.AbsoluteSize.Y + 5
							end
						end
						return h
					end

					local open = false
					local sizeConn
					btn.MouseButton1Click:Connect(function()
						open = not open
						if open then
							tween(tog, { Rotation = 90 }, options.tween_time)
							objs.Visible = true
							if sizeConn then sizeConn:Disconnect() end
							sizeConn = RunService.Heartbeat:Connect(function()
								if open then
									fld.Size = UDim2.new(1, 0, 0, calc_height())
								elseif sizeConn then
									sizeConn:Disconnect()
									sizeConn = nil
								end
							end)
						else
							tween(tog, { Rotation = 0 }, options.tween_time)
							objs.Visible = false
							fld.Size = UDim2.new(1, 0, 0, 20)
							if sizeConn then
								sizeConn:Disconnect()
								sizeConn = nil
							end
						end
					end)

					for method, fn in pairs(tab_data) do
						folder_data[method] = function(...)
							local results = { fn(...) }
							local last = results[#results]
							last.Parent = objs
							return table.unpack(results)
						end
					end
					return folder_data, fld
				end
			end
			return tab_data, TabFrame
		end
	end

	for _, desc in ipairs(Window:GetDescendants()) do
		if has_property(desc, "ZIndex") then
			desc.ZIndex = desc.ZIndex + (window_count * 10)
		end
	end
	return window_data, Window
end

script.AncestryChanged:Connect(function()
	if not script.Parent then
		disconnect_all()
	end
end)

return library
