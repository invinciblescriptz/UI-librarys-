			local function spawn_particles(btn)
				if btn ~= currentTabBtn then return end
				local size = btn.AbsoluteSize
				for i = 1, 3 do
					task.spawn(function()
						local p = Instance.new("Frame")
						p.Name = "SimpleParticle"
						p.Size = UDim2.new(0, 1.5, 0, 1.5)
						p.AnchorPoint = Vector2.new(0.5, 0.5)
						p.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
						p.BorderSizePixel = 0
						p.ZIndex = btn.ZIndex + 15
						local c = Instance.new("UICorner")
						c.CornerRadius = UDim.new(1, 0)
						c.Parent = p

						local side = math.random(1, 4)
						local px, py = 0, 0
						if side == 1 then
							px = math.random(5, size.X - 5)
							py = 1
						elseif side == 2 then
							px = size.X - 1
							py = math.random(5, size.Y - 5)
						elseif side == 3 then
							px = math.random(5, size.X - 5)
							py = size.Y - 1
						else
							px = 1
							py = math.random(5, size.Y - 5)
						end
						p.Position = UDim2.new(0, px, 0, py)
						p.Parent = btn

						local cx, cy = size.X / 2, size.Y / 2
						local dx, dy = px - cx, py - cy
						local len = math.sqrt(dx * dx + dy * dy)
						dx, dy = dx / len, dy / len
						local tx = px + dx * 6
						local ty = py + dy * 6

						local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
						local tw = TweenService:Create(p, info, {
							Position = UDim2.new(0, tx, 0, ty),
							BackgroundTransparency = 1,
						})
						tw:Play()
						task.wait(0.5)
						if p and p.Parent then
							p:Destroy()
						end
					end)
				end
			end

