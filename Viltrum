library.AddWindow = function(self, titleText, options)
	window_count = window_count + 1
	local dropdown_open = false
	titleText = tostring(titleText or "New Window")
	options = (typeof(options) == "table") and options or ui_options
	options.tween_time = options.tween_time or 0.1
	options.title_bar = options.title_bar or { Color3.fromRGB(41, 74, 122) }
	if typeof(options.title_bar) == "Color3" then
		options.title_bar = { options.title_bar }
	end
	options.title_bar_transparency = options.title_bar_transparency or 0
	options.background = options.background or { Color3.new(0.08, 0.09, 0.1) }
	if typeof(options.background) == "Color3" then
		options.background = { options.background }
	end
	options.background_transparency = options.background_transparency or 0.1
	if not options.main_color then
		options.main_color = options.title_bar[1]
	end

	local Window = Prefabs:FindFirstChild("Window"):Clone()
	Window.Parent = Windows
	Window:FindFirstChild("Title").Text = titleText
	Window.Size = UDim2.new(0, options.min_size.X, 0, options.min_size.Y)
	Window.ZIndex = Window.ZIndex + (window_count * 10)

	do -- Title bar styling
		local Bar = Window:FindFirstChild("Bar")
		local TitleLabel = Bar:FindFirstChild("Title")
		local ToggleBtn = Bar:FindFirstChild("Toggle")
		local Base = Bar:FindFirstChild("Base")
		local Top = Bar:FindFirstChild("Top")
		local TabSel = Window:FindFirstChild("TabSelection")
		local underline = TabSel:FindFirstChild("Frame")
		local barHeight = 24
		local padding = (barHeight - 18) / 2

		Bar.Size = UDim2.new(1, 0, 0, barHeight)
		Bar.Position = UDim2.new(0, 0, 0, 0)

		if Base then Base:Destroy() end
		if Top then Top:Destroy() end

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = Bar

		if ToggleBtn then
			ToggleBtn.Position = UDim2.new(0, 5, 0, padding)
		end
		if TitleLabel then
			local leftPad = 25
			local rightPad = 5
			TitleLabel.Position = UDim2.new(0, leftPad, 0, padding)
			TitleLabel.Size = UDim2.new(1, -(leftPad + rightPad), 1, -padding * 2)
			TitleLabel.TextXAlignment = Enum.TextXAlignment.Center
		end

		Bar.BackgroundTransparency = options.title_bar_transparency
		apply_gradient(Bar, options.title_bar, 0)

		if TabSel then
			TabSel.Size = UDim2.new(1, -30, 0, 22)
			TabSel.Position = UDim2.new(0, 15, 0, 28)
			local tabCorner = Instance.new("UICorner")
			tabCorner.CornerRadius = UDim.new(0, 6)
			tabCorner.Parent = TabSel
			TabSel.ImageTransparency = 0.4
			apply_gradient(TabSel, options.title_bar, 45)

			local scroll = TabSel:FindFirstChild("TabScrolling")
			if scroll then
				local buttons = scroll:FindFirstChild("TabButtons")
				if buttons then
					local layout = buttons:FindFirstChild("UIListLayout")
					if layout then
						layout.VerticalAlignment = Enum.VerticalAlignment.Center
						layout.Padding = UDim.new(0, 12)
					end
				end
			end
			if underline then
				underline:Destroy()
			end
		end

		Window.ImageTransparency = options.background_transparency
		apply_gradient(Window, options.background, 45)

		local TabsFrame = Window:FindFirstChild("Tabs")
		ToggleBtn.MouseButton1Click:Connect(function()
			local visible = TabsFrame.Visible
			if visible then
				TabsFrame.Visible = false
				tween(Window, { Size = UDim2.new(0, Window.AbsoluteSize.X, 0, barHeight) }, options.tween_time)
			else
				TabsFrame.Visible = true
				Window.Size = UDim2.new(0, Window.AbsoluteSize.X, 0, options.min_size.Y)
			end
		end)
	end

	local Resizer = Window:WaitForChild("Resizer")
	local window_data = {}
	Window.Draggable = true

	do -- Resizing
		local oldIcon = Mouse.Icon
		local hovering = false
		Resizer.MouseEnter:Connect(function()
			Window.Draggable = false
			if options.can_resize then
				oldIcon = Mouse.Icon
			end
			hovering = true
		end)
		Resizer.MouseLeave:Connect(function()
			hovering = false
			if options.can_resize then
				Mouse.Icon = oldIcon
			end
			Window.Draggable = true
		end)

		local mouseDown = false
		local resizeConn
		UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				mouseDown = true
				if hovering and Resizer.Active and options.can_resize then
					resizeConn = RunService.Heartbeat:Connect(function()
						if not mouseDown or not Resizer.Active then
							if resizeConn then
								resizeConn:Disconnect()
								resizeConn = nil
							end
							return
						end
						local pos = get_mouse_pos()
						local newX = math.max(options.min_size.X, pos.X - Window.AbsolutePosition.X)
						local newY = math.max(options.min_size.Y, pos.Y - Window.AbsolutePosition.Y)
						Window.Size = UDim2.new(0, newX, 0, newY)
					end)
				end
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				mouseDown = false
				if resizeConn then
					resizeConn:Disconnect()
					resizeConn = nil
				end
			end
		end)
	end

	do -- Minimize / expand
		local ToggleBtn = Window:FindFirstChild("Bar"):FindFirstChild("Toggle")
		local expanded = true
		local canToggle = true
		local savedVisibility = {}
		local savedHeight = Window.AbsoluteSize.Y

		ToggleBtn.MouseButton1Click:Connect(function()
			if not canToggle then return end
			canToggle = false
			if expanded then
				savedVisibility = {}
				for _, child in ipairs(Window:FindFirstChild("Tabs"):GetChildren()) do
					savedVisibility[child] = child.Visible
					child.Visible = false
				end
				Resizer.Active = false
				savedHeight = Window.AbsoluteSize.Y
				tween(ToggleBtn, { Rotation = 0 }, options.tween_time)
				tween(Window, { Size = UDim2.new(0, Window.AbsoluteSize.X, 0, 26) }, options.tween_time)
				if ToggleBtn.Parent:FindFirstChild("Base") then
					ToggleBtn.Parent:FindFirstChild("Base").Transparency = 1
				end
			else
				for child, vis in pairs(savedVisibility) do
					child.Visible = vis
				end
				Resizer.Active = true
				tween(ToggleBtn, { Rotation = 0 }, options.tween_time)
				tween(Window, { Size = UDim2.new(0, Window.AbsoluteSize.X, 0, savedHeight) }, options.tween_time)
				if ToggleBtn.Parent:FindFirstChild("Base") then
					ToggleBtn.Parent:FindFirstChild("Base").Transparency = options.title_bar_transparency
				end
			end
			expanded = not expanded
			task.delay(options.tween_time, function()
				canToggle = true
			end)
		end)
	end

	do -- Tabs
		local TabsFrame = Window:FindFirstChild("Tabs")
		local TabSel = Window:FindFirstChild("TabSelection")
		local TabScroll = TabSel:FindFirstChild("TabScrolling")
		local TabButtonsFrame = TabScroll:FindFirstChild("TabButtons")
		local currentTabBtn = nil
		local particleConn = nil

		local function update_tab_buttons_size()
			local total = 0
			local pad = TabButtonsFrame:FindFirstChildOfClass("UIListLayout").Padding.Offset or 0
			for _, btn in ipairs(TabButtonsFrame:GetChildren()) do
				if btn:IsA("TextButton") then
					total = total + btn.AbsoluteSize.X + pad
				end
			end
			TabButtonsFrame.Size = UDim2.new(0, total, 1, 0)
			if TabScroll then
				TabScroll.CanvasSize = UDim2.new(0, total, 0, 0)
			end
		end

		window_data.AddTab = function(self, tabName)
			local tab_data = {}
			tabName = tostring(tabName or "New Tab")
			TabSel.Visible = true

			local TabBtn = Prefabs:FindFirstChild("TabButton"):Clone()
			TabBtn.Parent = TabButtonsFrame
			TabBtn.Text = tabName
			TabBtn.Size = UDim2.new(0, get_text_size(TabBtn) + 20, 0, 18)
			TabBtn.ZIndex = TabBtn.ZIndex + (window_count * 10)
			TabBtn.BackgroundTransparency = 1

			local roundify = TabBtn:GetChildren()[1]
			roundify.ZIndex = TabBtn.ZIndex + (window_count * 10)
			roundify.ImageTransparency = 1

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 4)
			corner.Parent = TabBtn

			TabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
			TabBtn.TextSize = 13
			TabBtn.Font = Enum.Font.FredokaOne

			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.new(0, 0, 0)
			stroke.Thickness = 1.2
			stroke.Transparency = 0.7
